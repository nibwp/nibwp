#: includes/premium/integrations/weglot.php:1127
msgid "A French page on an English URL ranks worse than one on a French URL."
msgstr "Una página en francés con una URL en inglés posiciona peor que una con una URL en francés."

#: includes/premium/integrations/weglot.php:1134
msgid "A translated site nobody can switch is a translated site nobody reads."
msgstr "Un sitio traducido en el que nadie puede cambiar de idioma es un sitio traducido que nadie lee."

#: includes/premium/integrations/weglot.php:1140
msgid "Country-specific pages, legal text that must stay in its original language, market-specific landing pages."
msgstr "Páginas específicas de un país, textos legales que deben quedarse en su idioma original, landing pages específicas de un mercado."

#: includes/premium/integrations/weglot.php:1146
msgid "Confirm the configuration before telling anyone the site is translated."
msgstr "Confirma la configuración antes de decirle a nadie que el sitio está traducido."

#: includes/premium/integrations/weglot.php:1155
msgid "Exclusions before languages, languages before polish. A word translated once is billed once, whatever you do afterwards."
msgstr "Exclusiones antes que idiomas, idiomas antes que retoques. Una palabra traducida una vez se factura una vez, hagas lo que hagas después."

