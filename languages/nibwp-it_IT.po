#. translators: %s: the X-Frame-Options header value
#: includes/status-checks.php:1771
#, php-format
msgid "The site sends X-Frame-Options: %s. A security plugin is usually responsible. Same-origin framing has to be allowed for the workspace to show anything; the rest of NibWP is unaffected."
msgstr "Il sito invia X-Frame-Options: %s. Di solito il responsabile è un plugin di sicurezza. Perché l'area di lavoro mostri qualcosa deve essere consentito l'inserimento in frame dalla stessa origine; il resto di NibWP non ne è interessato."

#: includes/status-checks.php:1775
msgid "Find the setting that sends X-Frame-Options and change DENY to SAMEORIGIN."
msgstr "Trova l'impostazione che invia X-Frame-Options e cambia DENY in SAMEORIGIN."

#: includes/status-checks.php:1776
msgid "On Cloudflare or a similar proxy, check the response-header transform rules."
msgstr "Su Cloudflare o un proxy simile, controlla le regole di trasformazione degli header di risposta."

#: includes/status-checks.php:1777
msgid "A Content-Security-Policy frame-ancestors rule can do the same thing."
msgstr "Una regola frame-ancestors della Content-Security-Policy può avere lo stesso effetto."

#: includes/status-checks.php:1788
msgid "The workspace can show this site in a frame."
msgstr "L'area di lavoro può mostrare questo sito in un frame."

