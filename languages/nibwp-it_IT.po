#: includes/premium/integrations/weglot.php:705
msgid "Weglot — Page translation control"
msgstr "Weglot — Controllo della traduzione delle pagine"

#: includes/premium/integrations/weglot.php:766
msgid "Weglot — Media, PDF and email"
msgstr "Weglot — Media, PDF ed email"

#: includes/premium/integrations/weglot.php:824
