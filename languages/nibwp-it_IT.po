msgid "On managed hosting, send your host this line: \"PHP is not receiving the HTTP Authorization header on REST API requests.\""
msgstr "Su un hosting gestito, invia al tuo hosting questa riga: \"PHP is not receiving the HTTP Authorization header on REST API requests.\""

#: includes/status-checks.php:941
msgid "If sign-in discovery also fails: allow /.well-known/oauth-* to reach WordPress (nginx: location ^~ /.well-known/oauth- { try_files $uri /index.php?$args; })."
msgstr "Se fallisce anche la discovery dell'accesso: consenti a /.well-known/oauth-* di raggiungere WordPress (nginx: location ^~ /.well-known/oauth- { try_files $uri /index.php?$args; })."

