#: includes/visual/visual-onboarding.php:951
msgid "Open <strong>Settings → Connectors</strong> in Claude Desktop."
msgstr "Apri <strong>Settings → Connectors</strong> in Claude Desktop."

#: includes/visual/visual-onboarding.php:952
msgid "Choose <strong>Add custom connector</strong>, name it, and paste the address."
msgstr "Scegli <strong>Add custom connector</strong>, assegna un nome e incolla l'indirizzo."

#: includes/visual/visual-onboarding.php:953
msgid "Leave the OAuth client ID and secret empty — this site needs neither."
msgstr "Lascia vuoti il client ID e il secret OAuth: questo sito non ne ha bisogno."

