#: includes/premium/integrations/weglot.php:491
msgid "Weglot — Exclusions"
msgstr "Weglot — Esclusioni"

#: includes/premium/integrations/weglot.php:574
msgid "Weglot — Language switcher"
msgstr "Weglot — Selettore di lingua"

#: includes/premium/integrations/weglot.php:626
msgid "Give either a button object or css."
msgstr "Fornisci un oggetto button oppure css."

#: includes/premium/integrations/weglot.php:651
msgid "Weglot — Translated slugs"
msgstr "Weglot — Slug tradotti"

#: includes/premium/integrations/weglot.php:680
