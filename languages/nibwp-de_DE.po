msgstr "zuletzt verwendet vor %s"

#: includes/oauth/oauth-connect-tab.php:955
msgid "never used"
msgstr "nie verwendet"

#: includes/oauth/oauth-connect-tab.php:1006
msgid "Sign-in asks your approval and hands over no password. A password gives full access and never expires."
msgstr "Die Anmeldung fragt nach deiner Zustimmung und gibt kein Passwort heraus. Ein Passwort gewährt vollen Zugriff und läuft nie ab."

#: includes/oauth/oauth-connect-tab.php:1012
msgid "OAuth"
msgstr "OAuth"

#: includes/oauth/oauth-consent.php:54
