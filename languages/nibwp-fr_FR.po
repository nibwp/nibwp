msgstr "Copilot lit la configuration MCP de VS Code : le même bouton fonctionne donc."

#: includes/oauth/oauth-connect-tab.php:633
msgid "Add to <code>mcp_config.json</code>."
msgstr "Ajoutez à <code>mcp_config.json</code>."

#: includes/oauth/oauth-connect-tab.php:639
