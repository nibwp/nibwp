msgstr "%1$s — %2$s: %3$s"

#: includes/status-checks.php:1059
msgid "The address AI clients are pointed at for sign-in does not answer."
msgstr "O endereço para o qual os clientes de IA são encaminhados para iniciar sessão não responde."

#: includes/status-checks.php:1062
msgid "Purge any page, object or edge cache, then re-run this diagnostic."
msgstr "Limpe qualquer cache de página, de objetos ou de edge e depois execute novamente este diagnóstico."

#: includes/status-checks.php:1063
#: includes/status-checks.php:1081
msgid "Check whether a security plugin, firewall or CDN blocks /.well-known/ paths."
msgstr "Verifique se um plugin de segurança, firewall ou CDN bloqueia os caminhos /.well-known/."

#: includes/status-checks.php:1064
