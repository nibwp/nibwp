#: includes/premium/integrations/weglot.php:980
msgid "Set allow_private to false when the site is ready."
msgstr "Zet allow_private op false als de site klaar is."

#: includes/premium/integrations/weglot.php:988
msgid "Nothing is excluded from translation. Code samples, brand names, SKUs and addresses are being translated along with the prose — and billed."
msgstr "Niets is uitgesloten van vertaling. Codevoorbeelden, merknamen, SKU's en adressen worden samen met de tekst vertaald — en gefactureerd."

#: includes/premium/integrations/weglot.php:989
msgid "Set exclusions with nibwp/weglot-exclusions. Start with code, pre and any syntax-highlighting class."
msgstr "Stel uitsluitingen in met nibwp/weglot-exclusions. Begin met code, pre en elke class voor syntax highlighting."

#. translators: %d: number of destination languages
#: includes/premium/integrations/weglot.php:998
#, php-format
msgid "%d destination languages. Every word on the site is translated once per language, so usage grows with the site, not just with the language count."
msgstr "%d doeltalen. Elk woord op de site wordt per taal één keer vertaald, dus het gebruik groeit mee met de site, niet alleen met het aantal talen."

#: includes/premium/integrations/weglot.php:1027
msgid "Weglot — Translation workflow"
msgstr "Weglot — Vertaalworkflow"

#: includes/premium/integrations/weglot.php:1082
msgid "Nothing translates without an API key."
msgstr "Zonder API-sleutel wordt er niets vertaald."

#: includes/premium/integrations/weglot.php:1089
msgid "Weglot bills by translated words across every language. Know the allowance before adding languages, because going over stops translation rather than charging quietly."
msgstr "Weglot factureert op vertaalde woorden over alle talen. Ken je tegoed voordat je talen toevoegt, want als je erover gaat stopt het vertalen in plaats van dat er stilletjes kosten worden gemaakt."

#: includes/premium/integrations/weglot.php:1098
msgid "Anything translated once is already billed. Excluding code, brand names and product codes before the first pass saves both quota and nonsense output."
msgstr "Alles wat één keer is vertaald, is al gefactureerd. Code, merknamen en productcodes uitsluiten vóór de eerste ronde bespaart zowel quotum als onzinnige uitvoer."

#. translators: %s: comma-separated language codes
#: includes/premium/integrations/weglot.php:1108
#, php-format
msgid "Not yet configured: %s. Each one multiplies word usage."
msgstr "Nog niet geconfigureerd: %s. Elke taal vermenigvuldigt het woordgebruik."

#: includes/premium/integrations/weglot.php:1119
msgid "Without it search engines cannot tell the language versions apart, and the translated pages compete with each other instead of ranking."
msgstr "Zonder dit kunnen zoekmachines de taalversies niet uit elkaar houden, en concurreren de vertaalde pagina's met elkaar in plaats van te scoren."

#: includes/premium/integrations/weglot.php:1127
msgid "A French page on an English URL ranks worse than one on a French URL."
msgstr "Een Franse pagina op een Engelse URL scoort slechter dan een op een Franse URL."

#: includes/premium/integrations/weglot.php:1134
msgid "A translated site nobody can switch is a translated site nobody reads."
msgstr "Een vertaalde site waar niemand van taal kan wisselen, is een vertaalde site die niemand leest."

#: includes/premium/integrations/weglot.php:1140
msgid "Country-specific pages, legal text that must stay in its original language, market-specific landing pages."
msgstr "Landspecifieke pagina's, juridische tekst die in de oorspronkelijke taal moet blijven, marktspecifieke landingspagina's."

#: includes/premium/integrations/weglot.php:1146
msgid "Confirm the configuration before telling anyone the site is translated."
msgstr "Bevestig de configuratie voordat je iemand vertelt dat de site vertaald is."

#: includes/premium/integrations/weglot.php:1155
msgid "Exclusions before languages, languages before polish. A word translated once is billed once, whatever you do afterwards."
msgstr "Uitsluitingen vóór talen, talen vóór de afwerking. Een woord dat één keer is vertaald, wordt één keer gefactureerd, wat je daarna ook doet."

#: includes/premium/integrations/weglot.php:1165
msgid "Weglot — Sync with the workspace"
msgstr "Weglot — Synchroniseren met de workspace"

#: includes/premium/integrations/weglot.php:1201
msgid "No Weglot API key is configured, so there is no workspace to sync with."
msgstr "Er is geen Weglot-API-sleutel geconfigureerd, dus er is geen workspace om mee te synchroniseren."

#: includes/premium/integrations/weglot.php:1209
msgid "This overwrites one side of the configuration with the other. Compare first, then re-issue with confirm true."
msgstr "Dit overschrijft de ene kant van de configuratie met de andere. Vergelijk eerst en doe het daarna opnieuw met confirm true."

#: includes/premium/integrations/weglot.php:1217
msgid "The Weglot option service is unavailable."
msgstr "De optiedienst van Weglot is niet beschikbaar."

#: includes/premium/integrations/weglot.php:1247
msgid "The workspace returned no configuration to pull."
msgstr "De workspace gaf geen configuratie terug om op te halen."

#: includes/premium/integrations/weglot.php:1250
msgid "This Weglot version does not expose replacing the local options."
msgstr "Deze versie van Weglot biedt geen mogelijkheid om de lokale opties te vervangen."

#: includes/premium/integrations/weglot.php:1259
msgid "This Weglot version does not expose pushing to the workspace."
msgstr "Deze versie van Weglot biedt geen mogelijkheid om naar de workspace door te sturen."

