#. translators: Skill feature: breakdance-pro
#: includes/i18n-data-strings.php:451
msgid "Turn screenshots and images into working Breakdance pages"
msgstr "حوّل لقطات الشاشة والصور إلى صفحات Breakdance تعمل"

#. translators: Skill feature: bricks-pro
#: includes/i18n-data-strings.php:453
msgid "Turn screenshots or images into fully working Bricks templates"
msgstr "حوّل لقطات الشاشة أو الصور إلى قوالب Bricks تعمل بالكامل"

#. translators: Skill feature: elementor-pro
#: includes/i18n-data-strings.php:455
msgid "Turn screenshots or images into fully working Elementor pages"
msgstr "حوّل لقطات الشاشة أو الصور إلى صفحات Elementor تعمل بالكامل"

#. translators: Skill feature: etchwp-pro
#: includes/i18n-data-strings.php:457
msgid "Turn screenshots or images into fully working EtchWP components"
msgstr "حوّل لقطات الشاشة أو الصور إلى مكوّنات EtchWP تعمل بالكامل"

#. translators: Skill feature: kadence-pro
#: includes/i18n-data-strings.php:459
msgid "Turn screenshots or images into fully working Kadence Blocks layouts"
msgstr "حوّل لقطات الشاشة أو الصور إلى تخطيطات Kadence Blocks تعمل بالكامل"

#. translators: Skill feature: figma-pro
#: includes/i18n-data-strings.php:461
msgid "Two read sources: Figma REST (headless default) or Figma Dev Mode MCP (live in-app context)"
msgstr "مصدران للقراءة: Figma REST (الافتراضي دون واجهة) أو Figma Dev Mode MCP (سياق مباشر داخل التطبيق)"

#. translators: Workflow summary: woocommerce-product
#: includes/i18n-data-strings.php:463
msgid "Type → pricing → images + alt → description → attributes/variations → inventory → SEO/schema → categories → publish."
msgstr "النوع ← التسعير ← الصور + النص البديل ← الوصف ← السمات/التنوّعات ← المخزون ← SEO/Schema ← التصنيفات ← النشر."

