msgstr "بيانات تعريف تسجيل الدخول (صيغة OpenID)"

#: includes/oauth/oauth-server.php:827
msgid "Sign-in metadata (OAuth form)"
msgstr "بيانات تعريف تسجيل الدخول (صيغة OAuth)"

