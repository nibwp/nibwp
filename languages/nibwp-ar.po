#: includes/i18n-data-strings.php:125
msgid "Convert HTML, URLs, images, or screenshots into native, editable Elementor pages — containers and widgets, not raw HTML"
msgstr "حوّل HTML أو عناوين URL أو الصور أو لقطات الشاشة إلى صفحات Elementor أصلية قابلة للتحرير — حاويات وودجات، لا HTML خام"

#. translators: Skill tagline: kadence-pro
#: includes/i18n-data-strings.php:127
msgid "Convert HTML, URLs, images, or screenshots into validated Kadence Blocks layouts, templates, and reusable patterns"
msgstr "حوّل HTML أو عناوين URL أو الصور أو لقطات الشاشة إلى تخطيطات وقوالب وأنماط قابلة لإعادة الاستخدام في Kadence Blocks متحقَّق منها"

#. translators: Skill tagline: bricks-pro
#: includes/i18n-data-strings.php:129
msgid "Convert HTML, URLs, images, screenshots, or Figma frames into validated Bricks templates with ACSS tokens, global classes, query loops, and dynamic data"
msgstr "حوّل HTML أو عناوين URL أو الصور أو لقطات الشاشة أو إطارات Figma إلى قوالب Bricks متحقَّق منها مع رموز ACSS، وأصناف عامة، وحلقات استعلام، وبيانات ديناميكية"

#. translators: Skill tagline: etchwp-pro
#: includes/i18n-data-strings.php:131
msgid "Convert HTML, URLs, images, screenshots, or Figma frames into validated EtchWP components"
msgstr "حوّل HTML أو عناوين URL أو الصور أو لقطات الشاشة أو إطارات Figma إلى مكوّنات EtchWP متحقَّق منها"

#. translators: Skill tagline: breakdance-pro
#: includes/i18n-data-strings.php:133
msgid "Convert HTML, URLs, screenshots or Figma frames into validated Breakdance pages and templates — checked against your own element registry and design tokens"
msgstr "حوّل HTML أو عناوين URL أو لقطات الشاشة أو إطارات Figma إلى صفحات وقوالب Breakdance متحقَّق منها — مع فحصها مقابل سجل العناصر ورموز التصميم الخاصة بك"

#. translators: Workflow title: convert-to-breakdance
#: includes/i18n-data-strings.php:135
